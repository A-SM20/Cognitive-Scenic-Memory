# =============================================================================
# Cognitive Scene Memory — Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.

# --- Object Detection ---
MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50

# --- Processing ---
PROCESS_EVERY_N_FRAMES=10

# --- Feature Flags ---
ENABLE_SEGMENTATION=false
ENABLE_FEATURE_MATCHING=true
ENABLE_DEPTH=false
ENABLE_LLM=false

# --- Memory ---
CONFIDENCE_DECAY=0.15
MOVEMENT_THRESHOLD=50.0

# --- Database ---
DATABASE_URL=sqlite:///./data/scene_memory.db

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Paths ---
UPLOAD_DIR=./data/uploads

# --- Logging ---
LOG_LEVEL=INFO
